# .env.production.example — POS Event Production Config

# --- APLIKASI ---
APP_NAME="POS Event System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos-event.example.com
APP_TIMEZONE=Asia/Jakarta
APP_LOG=storage/logs/laravel.log

# --- DATABASE ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_event_prod
DB_USERNAME=pos_event_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- QUEUE & CACHE ---
QUEUE_CONNECTION=database
QUEUE_WORKERS=2
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=480

# --- REDIS ---
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# --- LOGGING ---
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

# --- REVERB BROADCAST ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=pos-event-reverb
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- MAIL ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@pos-event.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- SANCTUM ---
SANCTUM_STATEFUL_DOMAINS=pos-event.example.com

# --- STORAGE ---
FILESYSTEM_DISK=local

# --- CRON SCHEDULER ---
# * * * * * cd /path/to/pos-event-backend && php artisan schedule:run >> /dev/null 2>&1
